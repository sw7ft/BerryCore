umask 002

# BerryCore splash owns the launch screen.
# Must be set BEFORE sourcing env.sh (skips plain banner + remote MOTD wait).
export BERRYCORE_QUIET=1
export BERRYCORE_MOTD_ENABLED=0
# export BERRYCORE_SETUP_AUTO=0   # skip app-catalog autostart + hub banner

# BerryCore Environment
BERRYCORE_ENV="/accounts/1000/shared/misc/berrycore/env.sh"
if [ -e $BERRYCORE_ENV ];then
    . $BERRYCORE_ENV
fi

# Keep URL for `bcmotd fetch` — login splash does not hit the network.
export BERRYCORE_MOTD_URL="https://raw.githubusercontent.com/sw7ft/berrycore/main/motd.txt"

# Term49 / SSH theme + splash
export TERM="${TERM:-xterm-256color}"

if [ -f /accounts/1000/shared/misc/berrycore/share/term49-splash.sh ]; then
    . /accounts/1000/shared/misc/berrycore/share/term49-splash.sh
fi

clear_screen() {
    printf '\033[2J\033[H'
    term49_theme 2>/dev/null
}

alias cls=clear_screen
alias clear=clear_screen

if [ -t 1 ]; then
    term49_splash
fi

