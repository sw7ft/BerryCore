#!/bin/sh
# youtube - YouTube Navigator v2 for BB10 (port 8070)

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
NATIVE_TOOLS="$(cd "$BIN_DIR/.." 2>/dev/null && pwd)"
[ -z "$NATIVE_TOOLS" ] && NATIVE_TOOLS="/accounts/1000/shared/misc/berrycore"
SHARE="$NATIVE_TOOLS/share/youtube"
PORT=8070
BC_PY="$NATIVE_TOOLS/lib/python3_ntoarmv7-qnx-static/tools/python3/python3"
BC_HOME="$NATIVE_TOOLS/lib/python3_ntoarmv7-qnx-static"

FOREGROUND=0
for arg in "$@"; do
    case "$arg" in
        help|-h|--help)
            cat "$SHARE/HELP.txt" 2>/dev/null || echo "youtube v2 - port $PORT"
            exit 0
            ;;
        -f|--foreground) FOREGROUND=1 ;;
    esac
done

# Always use berrycore python with PYTHONHOME — pytube lives here.
# No import checks; embed playback works even if pytube is unavailable.
if [ -x "$BC_PY" ]; then
    PYTHON="$BC_PY"
    export PYTHONHOME="$BC_HOME"
elif command -v python3.2 >/dev/null 2>&1; then
    PYTHON="python3.2"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    echo "youtube: python3 not found"
    exit 1
fi

if [ ! -f "$SHARE/app.py" ]; then
    echo "youtube: app.py not found at $SHARE"
    exit 1
fi

if [ "$FOREGROUND" = 1 ]; then
    exec env PYTHONHOME="$PYTHONHOME" "$PYTHON" "$SHARE/app.py"
fi

LOG="$SHARE/youtube.log"
echo "youtube: starting on port $PORT"
echo "Open http://localhost:$PORT"
nohup env PYTHONHOME="$PYTHONHOME" "$PYTHON" "$SHARE/app.py" >> "$LOG" 2>&1 &
