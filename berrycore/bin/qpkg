#!/bin/sh
# qpkg - QNX Package Manager for BerryCore
# Manage BerryCore updates and install additional ports

VERSION="0.1.0"
GITHUB_REPO="sw7ft/BerryCore"
GITHUB_API="https://api.github.com/repos/$GITHUB_REPO"
GITHUB_RAW="https://raw.githubusercontent.com/$GITHUB_REPO/main"
DOWNLOAD_DIR="/accounts/1000/shared/documents"

# Colors (if terminal supports it)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    BOLD=''
    NC=''
fi

# Helper functions
print_header() {
    echo ""
    echo "==========================================="
    echo "  $1"
    echo "==========================================="
    echo ""
}

print_success() {
    echo "${GREEN}✓${NC} $1"
}

print_error() {
    echo "${RED}✗${NC} $1"
}

print_info() {
    echo "${BLUE}ℹ${NC} $1"
}

print_warning() {
    echo "${YELLOW}⚠${NC} $1"
}

# Default install uses shared misc/{bin,share}; custom names (e.g. berrycore4) stay self-contained.
qpkg_is_shared_misc_layout() {
    [ "$(basename "$NATIVE_TOOLS")" = "berrycore" ]
}

qpkg_misc_root() {
    if qpkg_is_shared_misc_layout; then
        echo "/accounts/1000/shared/misc"
    else
        echo "$NATIVE_TOOLS"
    fi
}

qpkg_misc_app_root() {
    if qpkg_is_shared_misc_layout; then
        echo "/accounts/1000/shared/misc"
    else
        echo "$(dirname "$NATIVE_TOOLS")"
    fi
}

qpkg_port_doc() {
    _port="$1"
    echo "$(qpkg_misc_root)/share/doc/${_port}/MANUAL.md"
}

# Extract port zip via staging dir (avoids unzip "cannot delete" on locked QNX files).
qpkg_extract_port_zip() {
    _zip="$1"
    _dest="$2"
    _stage="$3"
    mkdir -p "$_stage" "$_dest" || return 1
    unzip -o -q "$_zip" -d "$_stage" 2>/dev/null || \
        unzip -o "$_zip" -d "$_stage" 2>&1 | grep -v "Archive:" | grep -v "inflating:" || true
    _item=""
    for _item in "$_stage"/*; do
        [ -e "$_item" ] || continue
        _base=$(basename "$_item")
        if [ -d "$_item" ]; then
            mkdir -p "$_dest/$_base"
            cp -R "$_item/"* "$_dest/$_base/" 2>/dev/null || true
        else
            cp "$_item" "$_dest/" 2>/dev/null || true
        fi
    done
    return 0
}

# Resolve BerryCore root (bin/qpkg -> ..). Safe if env.sh was not sourced.
init_native_tools() {
    if [ -n "$NATIVE_TOOLS" ] && [ -f "$NATIVE_TOOLS/env.sh" ]; then
        return 0
    fi

    QPKG_BIN=""
    if [ -n "$0" ] && [ -f "$0" ]; then
        QPKG_BIN="$0"
    elif command -v qpkg >/dev/null 2>&1; then
        QPKG_BIN=$(command -v qpkg)
    fi

    if [ -n "$QPKG_BIN" ]; then
        BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$QPKG_BIN")" && pwd)
        if [ -f "$BIN_DIR/../env.sh" ]; then
            NATIVE_TOOLS=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
            export NATIVE_TOOLS
            return 0
        fi
    fi

    if [ -f "/accounts/1000/shared/misc/berrycore/env.sh" ]; then
        NATIVE_TOOLS="/accounts/1000/shared/misc/berrycore"
        export NATIVE_TOOLS
        return 0
    fi

    print_error "BerryCore root not found (NATIVE_TOOLS unset)."
    echo ""
    echo "Run:  . /accounts/1000/shared/misc/berrycore/env.sh"
    echo "  or: export NATIVE_TOOLS=/path/to/berrycore"
    exit 1
}

# --- Ports catalog (FEATURED + PACKAGES) ---

QPKG_CACHE_DIR=""
QPKG_CACHE_TTL=86400

init_qpkg_cache() {
    QPKG_CACHE_DIR="${NATIVE_TOOLS}/.cache/qpkg"
    mkdir -p "$QPKG_CACHE_DIR" 2>/dev/null || QPKG_CACHE_DIR="/tmp/qpkg-cache-$$"
    mkdir -p "$QPKG_CACHE_DIR" 2>/dev/null || true
}

fetch_ports_file() {
    _file="$1"
    init_qpkg_cache
    _url="$GITHUB_RAW/ports/$_file"
    _cache="$QPKG_CACHE_DIR/$_file"
    _now=$(date +%s 2>/dev/null || echo 0)
    _cached_lines=0
    if [ -f "$_cache" ]; then
        _cached_lines=$(grep -v '^#' "$_cache" 2>/dev/null | grep -vc '^$' || echo 0)
    fi

    _use_cache=0
    if [ -f "$_cache" ] && [ "$_cached_lines" -gt 0 ]; then
        _mtime=$(stat -c %Y "$_cache" 2>/dev/null || stat -f %m "$_cache" 2>/dev/null || echo "")
        if [ -z "$_mtime" ] || [ "$_mtime" = "0" ]; then
            _use_cache=1
        elif [ "$_now" != "0" ] && [ $((_now - _mtime)) -lt "$QPKG_CACHE_TTL" ]; then
            _use_cache=1
        fi
    fi

    if [ "$_use_cache" = 1 ]; then
        cat "$_cache"
        return 0
    fi

    _content=$(curl -s -k -L -m 20 "$_url" 2>&1)
    _new_lines=0
    if [ -n "$_content" ]; then
        _new_lines=$(echo "$_content" | grep -v '^#' | grep -vc '^$' || echo 0)
    fi

    if [ -n "$_content" ] && ! echo "$_content" | head -1 | grep -qi '<html'; then
        if [ "$_new_lines" -ge "$_cached_lines" ] || [ "$_cached_lines" -eq 0 ]; then
            echo "$_content" > "$_cache" 2>/dev/null || true
            echo "$_content"
            return 0
        fi
    fi

    if [ -f "$_cache" ] && [ "$_cached_lines" -gt 0 ]; then
        print_warning "Using cached $_file (remote stale or unavailable)" >&2
        cat "$_cache"
        return 0
    fi

    return 1
}

fetch_packages_content() {
    _c=$(fetch_ports_file PACKAGES)
    if [ $? -eq 0 ] && [ -n "$_c" ]; then
        echo "$_c"
        return 0
    fi
    print_warning "PACKAGES not found; falling back to INDEX"
    fetch_ports_file INDEX
}

lookup_package_line() {
    _name="$1"
    _content="$2"
    echo "$_content" | grep -v "^#" | grep -v "^$" | grep "^${_name}|" | head -1
}

parse_package_fields() {
    _line="$1"
    PKG_NAME=$(echo "$_line" | cut -d'|' -f1)
    PKG_CATEGORY=$(echo "$_line" | cut -d'|' -f2)
    PKG_VERSION=$(echo "$_line" | cut -d'|' -f3)
    PKG_SIZE=$(echo "$_line" | cut -d'|' -f4)
    PKG_DESC=$(echo "$_line" | cut -d'|' -f5)
    PKG_ZIP=$(echo "$_line" | cut -d'|' -f6)
    PKG_REPLACES=$(echo "$_line" | cut -d'|' -f7)
    if [ -z "$PKG_ZIP" ]; then
        PKG_ZIP="${PKG_CATEGORY}-${PKG_NAME}-${PKG_VERSION}.zip"
    fi
    if [ -z "$PKG_REPLACES" ]; then
        PKG_REPLACES="none"
    fi
}

log_installed_port() {
    _name="$1"
    _ver="$2"
    _zip="$3"
    _log="${NATIVE_TOOLS}/.qpkg/installed"
    mkdir -p "${NATIVE_TOOLS}/.qpkg" 2>/dev/null || true
    _date=$(date +%Y-%m-%d 2>/dev/null || echo "unknown")
    echo "${_name}|${_ver}|${_date}|${_zip}" >> "$_log" 2>/dev/null || true
}

check_replaces_warning() {
    _name="$1"
    _replaces="$2"
    case "$_replaces" in
        none|"") return 0 ;;
        core)
            if [ -f "$NATIVE_TOOLS/bin/$_name" ] || [ -L "$NATIVE_TOOLS/bin/$_name" ]; then
                print_warning "This port may replace core binary: $NATIVE_TOOLS/bin/$_name"
            fi
            ;;
        *)
            print_warning "This port replaces: $_replaces"
            ;;
    esac
}

display_package_row() {
    _name="$1"
    _cat="$2"
    _ver="$3"
    _size="$4"
    _desc="$5"
    printf "  ${GREEN}%-20s${NC} ${BLUE}[%s]${NC} v%-6s %-6s %s\n" "$_name" "$_cat" "$_ver" "$_size" "$_desc"
}

# Get current installed version
get_current_version() {
    if [ -f "$NATIVE_TOOLS/VERSION" ]; then
        tr -d '\r' < "$NATIVE_TOOLS/VERSION" | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
    else
        echo "unknown"
    fi
}

# Check for updates via GitHub API — version only on stdout (for $(...))
check_for_updates() {
    print_info "Checking for updates..." >&2

    RELEASE_JSON=$(curl -s -k -m 15 "$GITHUB_API/releases/latest" 2>/dev/null)

    if [ -z "$RELEASE_JSON" ]; then
        print_error "Failed to connect to GitHub. Check your internet connection." >&2
        return 1
    fi

    LATEST_VERSION=$(echo "$RELEASE_JSON" | grep '"tag_name"' | sed 's/.*"v\([^"]*\)".*/\1/' | head -1)

    if [ -z "$LATEST_VERSION" ]; then
        print_error "Could not determine latest version." >&2
        return 1
    fi

    echo "$LATEST_VERSION"
}

# Compare versions — returns 0 if $1 > $2 (handles x.y.z without python3)
version_greater() {
    _new="$1"
    _old="$2"

    if command -v python3 >/dev/null 2>&1; then
        if python3 -c "
def parts(v):
    return [int(x) for x in v.split('.') if x.isdigit()]
a, b = parts('$_new'), parts('$_old')
n = max(len(a), len(b))
a += [0] * (n - len(a))
b += [0] * (n - len(b))
import sys
sys.exit(0 if a > b else 1)
" 2>/dev/null; then
            return 0
        fi
    fi

    _i=1
    while [ "$_i" -le 10 ]; do
        _va=$(echo "$_new" | cut -d. -s -f"$_i")
        _vb=$(echo "$_old" | cut -d. -s -f"$_i")
        if [ -z "$_va" ] && [ -z "$_vb" ]; then
            return 1
        fi
        if [ -z "$_va" ]; then _va=0; fi
        if [ -z "$_vb" ]; then _vb=0; fi
        _va=$(echo "$_va" | sed 's/[^0-9].*//')
        _vb=$(echo "$_vb" | sed 's/[^0-9].*//')
        [ -z "$_va" ] && _va=0
        [ -z "$_vb" ] && _vb=0
        if [ "$_va" -gt "$_vb" ]; then return 0; fi
        if [ "$_va" -lt "$_vb" ]; then return 1; fi
        _i=$((_i + 1))
    done
    return 1
}

# Download file (QNX-safe: no grep -o in progress parsing)
download_file() {
    URL="$1"
    OUTPUT="$2"
    FILENAME=$(basename "$OUTPUT")
    OUT_DIR=$(dirname "$OUTPUT")

    print_info "Downloading $FILENAME..."

    if [ -n "$OUT_DIR" ] && [ "$OUT_DIR" != "." ]; then
        if ! mkdir -p "$OUT_DIR" 2>/dev/null; then
            print_error "Cannot create directory: $OUT_DIR"
            return 1
        fi
    fi

    if command -v curl >/dev/null 2>&1; then
        if ! curl -k -L -f -o "$OUTPUT" "$URL" 2>/dev/null; then
            if ! curl -k -L -o "$OUTPUT" "$URL" 2>/dev/null; then
                print_error "Download failed: $FILENAME"
                return 1
            fi
        fi
    elif command -v wget >/dev/null 2>&1; then
        if ! wget -q -O "$OUTPUT" "$URL" 2>/dev/null; then
            print_error "Download failed: $FILENAME"
            return 1
        fi
    else
        print_error "No download tool available (curl or wget required)"
        return 1
    fi

    if [ -f "$OUTPUT" ] && [ -s "$OUTPUT" ]; then
        print_success "Downloaded $FILENAME"
        return 0
    fi

    print_error "Download failed: $FILENAME (missing or empty)"
    rm -f "$OUTPUT" 2>/dev/null
    return 1
}

# Update BerryCore
cmd_update() {
    FORCE=0
    YES=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--force) FORCE=1; shift ;;
            -y|--yes) YES=1; shift ;;
            *) shift ;;
        esac
    done

    print_header "BerryCore Update Manager"

    CURRENT_VERSION=$(get_current_version)
    echo "Current version: ${BOLD}v${CURRENT_VERSION}${NC}"
    echo ""

    LATEST_VERSION=$(check_for_updates)
    if [ $? -ne 0 ]; then
        exit 1
    fi

    echo "Latest version:  ${BOLD}v${LATEST_VERSION}${NC}"
    echo ""

    if [ "$FORCE" -eq 0 ]; then
        if [ "$CURRENT_VERSION" = "$LATEST_VERSION" ]; then
            print_success "You're already on the latest version!"
            echo ""
            echo "To reinstall anyway: ${GREEN}qpkg update --force${NC}"
            exit 0
        fi

        if ! version_greater "$LATEST_VERSION" "$CURRENT_VERSION"; then
            print_info "Your version ($CURRENT_VERSION) is newer than the release ($LATEST_VERSION)"
            exit 0
        fi
    else
        print_warning "Force reinstall — downloading v${LATEST_VERSION} over v${CURRENT_VERSION}"
        echo ""
    fi

    # New version available
    print_success "New version available: v${LATEST_VERSION}"
    echo ""

    # Fetch release notes
    RELEASE_BODY=$(curl -s -k "$GITHUB_API/releases/latest" | grep -A 50 '"body"' | sed '1d' | sed 's/^[[:space:]]*"//' | head -20)
    if [ -n "$RELEASE_BODY" ]; then
        echo "${BOLD}What's new:${NC}"
        echo "$RELEASE_BODY" | head -10
        echo ""
    fi

    # Confirm update
    if [ "$YES" -eq 1 ]; then
        CONFIRM="y"
    else
        echo -n "Download and install v${LATEST_VERSION}? [Y/n]: "
        read CONFIRM
    fi

    if [ "$CONFIRM" != "" ] && [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        echo "Update cancelled."
        exit 0
    fi
    
    echo ""
    print_header "Downloading BerryCore v${LATEST_VERSION}"
    
    # Download URLs
    BERRYCORE_URL="https://github.com/$GITHUB_REPO/releases/download/v${LATEST_VERSION}/berrycore.zip"
    INSTALL_URL="https://github.com/$GITHUB_REPO/releases/download/v${LATEST_VERSION}/install.sh"
    
    # Download files
    if ! mkdir -p "$DOWNLOAD_DIR" 2>/dev/null; then
        print_error "Cannot create download directory: $DOWNLOAD_DIR"
        exit 1
    fi
    cd "$DOWNLOAD_DIR" || exit 1
    
    download_file "$BERRYCORE_URL" "berrycore.zip"
    if [ $? -ne 0 ]; then
        print_error "Failed to download berrycore.zip"
        exit 1
    fi
    
    download_file "$INSTALL_URL" "install.sh"
    if [ $? -ne 0 ]; then
        print_error "Failed to download install.sh"
        exit 1
    fi
    
    chmod +x install.sh
    
    echo ""
    print_header "Installing BerryCore v${LATEST_VERSION}"
    
    # Non-interactive upgrade into the current BerryCore tree
    if ! BERRYCORE_INSTALL_DIR="$NATIVE_TOOLS" sh ./install.sh --upgrade -y --dir "$NATIVE_TOOLS"; then
        print_error "Installation failed. Check errors above."
        exit 1
    fi

    echo ""
    print_success "BerryCore updated to v${LATEST_VERSION}!"
    echo ""
    echo "Restart your shell or run: source $NATIVE_TOOLS/env.sh"
}

# List featured ports (showcase)
cmd_ports() {
    print_header "Featured Ports"

    print_info "Fetching featured ports from GitHub..."
    echo ""

    FEATURED_CONTENT=$(fetch_ports_file FEATURED)
    if [ $? -ne 0 ] || [ -z "$FEATURED_CONTENT" ]; then
        print_warning "FEATURED not available; showing legacy INDEX"
        FEATURED_CONTENT=$(fetch_ports_file INDEX)
    fi

    if [ $? -ne 0 ] || [ -z "$FEATURED_CONTENT" ]; then
        print_error "Failed to fetch ports catalog from GitHub"
        echo "Try: https://github.com/$GITHUB_REPO/tree/main/ports"
        exit 1
    fi

    {
        echo "Featured ports to install:"
        echo "==========================================================="
        echo ""

        echo "$FEATURED_CONTENT" | grep -v "^#" | grep -v "^$" | while IFS='|' read -r name cat ver size desc; do
            display_package_row "$name" "$cat" "$ver" "$size" "$desc"
        done

        echo ""
        echo "Install with: ${GREEN}qpkg install <port-name>${NC}"
        echo "Full catalog: ${GREEN}qpkg search <term>${NC}  or  ${GREEN}qpkg available${NC}"
        echo ""
    } | paginate
}

# Install BerryCore AI (bcllm) — always write real ai wrapper (never symlink)
install_bcllm_ai() {
    BCLLM="$1"
    if [ ! -d "$BCLLM/bin" ]; then
        print_error "bcllm not found at $BCLLM"
        return 1
    fi
    if [ ! -x "$BCLLM/bin/bcllm-ai" ]; then
        print_error "bcllm-ai missing at $BCLLM/bin/bcllm-ai"
        return 1
    fi

    chmod +x "$BCLLM/bin/"* 2>/dev/null
    mkdir -p "$BCLLM/models" "$BCLLM/var" "$NATIVE_TOOLS/bin" 2>/dev/null

    rm -f "$BCLLM/bin/ai" "$BCLLM/bin/AI" "$NATIVE_TOOLS/bin/ai" "$NATIVE_TOOLS/bin/AI"

    if [ -f "$BCLLM/bin/berrycore-ai" ]; then
        cp "$BCLLM/bin/berrycore-ai" "$BCLLM/bin/ai"
    else
        cat > "$BCLLM/bin/ai" << 'BCLLM_WRAP'
#!/bin/sh
exec /accounts/1000/shared/misc/bcllm/bin/bcllm-ai "$@"
BCLLM_WRAP
    fi
    chmod +x "$BCLLM/bin/ai"
    cp "$BCLLM/bin/ai" "$NATIVE_TOOLS/bin/ai"
    chmod +x "$NATIVE_TOOLS/bin/ai"
    ln -sf ai "$NATIVE_TOOLS/bin/AI" 2>/dev/null || true
    [ -x "$BCLLM/bin/bcllm" ] && ln -sf "$BCLLM/bin/bcllm" "$NATIVE_TOOLS/bin/bcllm" 2>/dev/null || true

    if [ -x "$BCLLM/setup-ai.sh" ]; then
        export NATIVE_TOOLS
        sh "$BCLLM/setup-ai.sh" 2>/dev/null || true
    fi

    export PATH="$NATIVE_TOOLS/bin:$PATH"

    echo "BerryCore AI installed to $BCLLM/"
    echo "  ai command: $NATIVE_TOOLS/bin/ai"
    echo ""
    if type ai 2>/dev/null | grep -q function; then
        print_warning "~/.ai_cli.sh may override ai — comment it out in ~/.profile"
    fi
    echo "Try now:"
    echo '  ai "What is the capital of France?"'
    echo "  ai download smollm2_135m"
    echo "  ai web"
    echo ""
    echo "Help: $BCLLM/share/bcllm/HELP.txt"
    return 0
}

# Install BDK CLI — misc/bdk-cli + berrycore/bin wrapper
install_bdk_cli() {
    BDK="$1"
    if [ ! -d "$BDK/bin" ]; then
        print_error "bdk-cli not found at $BDK"
        return 1
    fi
    if [ ! -x "$BDK/bin/bdk-cli" ]; then
        print_error "bdk-cli binary missing at $BDK/bin/bdk-cli"
        return 1
    fi

    chmod +x "$BDK/bin/"* 2>/dev/null
    mkdir -p "$BDK/data" "$NATIVE_TOOLS/bin" 2>/dev/null

    if [ -x "$BDK/setup-bdk-cli.sh" ]; then
        export NATIVE_TOOLS
        sh "$BDK/setup-bdk-cli.sh"
    else
        mkdir -p "$NATIVE_TOOLS/bin" "$BDK/data"
        cp "$BDK/bin/berrycore-bdk-cli" "$NATIVE_TOOLS/bin/bdk-cli" 2>/dev/null || \
        cat > "$NATIVE_TOOLS/bin/bdk-cli" << 'BDK_WRAP'
#!/bin/sh
BDK_HOME="/accounts/1000/shared/misc/bdk-cli"
NT="${NATIVE_TOOLS:-/accounts/1000/shared/misc/berrycore}"
export DATADIR="${DATADIR:-$BDK_HOME/data}"
export SSL_CERT_FILE="${SSL_CERT_FILE:-$NT/certs/cacert.pem}"
mkdir -p "$DATADIR"
exec "$BDK_HOME/bin/bdk-cli" "$@"
BDK_WRAP
        chmod +x "$NATIVE_TOOLS/bin/bdk-cli"
    fi

    export PATH="$NATIVE_TOOLS/bin:$PATH"

    echo "BDK CLI installed to $BDK/"
    echo "  bdk-cli command: $NATIVE_TOOLS/bin/bdk-cli"
    echo ""
    echo "Try (testnet only):"
    echo "  bdk-cli key generate"
    echo '  bdk-cli -n testnet wallet -w mywallet -e "wpkh(tpub.../*)" \'
    echo '    --client-type electrum --database-type sqlite \'
    echo '    --url "ssl://electrum.blockstream.info:60002" sync'
    echo ""
    echo "Help: $BDK/share/bdk-cli/HELP.txt"
    return 0
}

# Install OpenPort — misc/bin (or NATIVE_TOOLS/bin) + berrycore/bin symlinks when shared layout
install_openport() {
    _root=$(qpkg_misc_root)
    MISC_BIN="$_root/bin"
    if [ ! -x "$MISC_BIN/openport" ]; then
        print_error "openport not found at $MISC_BIN/openport"
        return 1
    fi
    chmod +x "$MISC_BIN/openport" "$MISC_BIN/openport-canlog" 2>/dev/null || true
    mkdir -p "$NATIVE_TOOLS/bin" 2>/dev/null
    if qpkg_is_shared_misc_layout; then
        ln -sf "$MISC_BIN/openport" "$NATIVE_TOOLS/bin/openport" 2>/dev/null || \
            cp "$MISC_BIN/openport" "$NATIVE_TOOLS/bin/openport"
        ln -sf "$MISC_BIN/openport-canlog" "$NATIVE_TOOLS/bin/openport-canlog" 2>/dev/null || \
            cp "$MISC_BIN/openport-canlog" "$NATIVE_TOOLS/bin/openport-canlog" 2>/dev/null || true
    fi
    chmod +x "$NATIVE_TOOLS/bin/openport" 2>/dev/null || true
    echo "OpenPort installed to $MISC_BIN/"
    echo "  openport command: $NATIVE_TOOLS/bin/openport"
    echo ""
    echo "Try:"
    echo "  openport identify"
    echo "  openport -p /dev/serusb1 voltage"
    echo ""
    echo "Manual: $(qpkg_port_doc openport)"
    return 0
}

# Symlink misc/bin tools into berrycore/bin (shared layout only)
install_misc_bin() {
    _root=$(qpkg_misc_root)
    MISC_BIN="$_root/bin"
    mkdir -p "$NATIVE_TOOLS/bin" 2>/dev/null
    for bin in "$@"; do
        if [ ! -x "$MISC_BIN/$bin" ] && [ ! -L "$MISC_BIN/$bin" ]; then
            print_error "$bin not found at $MISC_BIN/$bin"
            return 1
        fi
        chmod +x "$MISC_BIN/$bin" 2>/dev/null || true
        if qpkg_is_shared_misc_layout; then
            ln -sf "$MISC_BIN/$bin" "$NATIVE_TOOLS/bin/$bin" 2>/dev/null || \
                cp "$MISC_BIN/$bin" "$NATIVE_TOOLS/bin/$bin"
        fi
        chmod +x "$NATIVE_TOOLS/bin/$bin" 2>/dev/null || true
    done
    return 0
}

# Install a port
cmd_install() {
    PORT_NAME="$1"

    # Legacy port name → berry-browser
    case "$PORT_NAME" in
        content-shell-term49) PORT_NAME="berry-browser" ;;
    esac
    
    if [ -z "$PORT_NAME" ]; then
        print_error "Usage: qpkg install <package-name>"
        exit 1
    fi
    
    print_header "Installing Port: $PORT_NAME"
    
    print_info "Searching catalog for: $PORT_NAME"
    PACKAGES_CONTENT=$(fetch_packages_content)
    CURL_EXIT=$?

    if [ $CURL_EXIT -ne 0 ] || [ -z "$PACKAGES_CONTENT" ]; then
        print_error "Failed to fetch package catalog from GitHub"
        exit 1
    fi

    PORT_INFO=$(lookup_package_line "$PORT_NAME" "$PACKAGES_CONTENT")

    if [ -z "$PORT_INFO" ]; then
        print_error "Package '$PORT_NAME' not found in catalog"
        echo ""
        echo "Try: qpkg search $PORT_NAME"
        echo "     qpkg available"
        echo "     qpkg ports          (featured only)"
        exit 1
    fi

    parse_package_fields "$PORT_INFO"
    CATEGORY="$PKG_CATEGORY"
    VERSION="$PKG_VERSION"
    SIZE="$PKG_SIZE"
    DESCRIPTION="$PKG_DESC"

    check_replaces_warning "$PORT_NAME" "$PKG_REPLACES"

    FILENAME="$PKG_ZIP"
    DOWNLOAD_URL="$GITHUB_RAW/ports/$FILENAME"
    
    echo ""
    echo "Port: $PORT_NAME v$VERSION"
    echo "Category: $CATEGORY"
    echo "Size: $SIZE"
    echo "Description: $DESCRIPTION"
    echo ""
    echo "Download URL: $DOWNLOAD_URL"
    echo ""
    echo -n "Install this port? [Y/n]: "
    read CONFIRM
    
    if [ "$CONFIRM" != "" ] && [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        echo "Installation cancelled."
        exit 0
    fi
    
    # Create temp directory in NATIVE_TOOLS (QNX /tmp may not be writable)
    TEMP_DIR="$NATIVE_TOOLS/.tmp/qpkg-$PORT_NAME-$$"
    if ! mkdir -p "$TEMP_DIR" 2>/dev/null; then
        print_error "Cannot create temp directory: $TEMP_DIR"
        echo ""
        echo "BerryCore root: $NATIVE_TOOLS"
        echo "Run:  . $NATIVE_TOOLS/env.sh"
        echo "  or: check write permission on $NATIVE_TOOLS"
        exit 1
    fi

    echo ""
    if [ -f "$NATIVE_TOOLS/packages/$FILENAME" ]; then
        print_info "Using bundled package: $NATIVE_TOOLS/packages/$FILENAME"
        cp "$NATIVE_TOOLS/packages/$FILENAME" "$TEMP_DIR/$FILENAME"
    elif ! download_file "$DOWNLOAD_URL" "$TEMP_DIR/$FILENAME"; then
        rm -rf "$TEMP_DIR"
        exit 1
    fi
    
    # Install - most ports extract to NATIVE_TOOLS; misc-bin ports use shared or local layout
    INSTALL_DIR="$NATIVE_TOOLS"
    case "$PORT_NAME" in
        android-apps)
            INSTALL_DIR="$(qpkg_misc_app_root)"
            ;;
        bcllm|bdk-cli)
            INSTALL_DIR="$(qpkg_misc_app_root)"
            ;;
        openport|telnet|usbdbg|dropbear|bbm|ftp)
            INSTALL_DIR="$(qpkg_misc_root)"
            ;;
    esac
    
    echo ""
    print_info "Installing to $INSTALL_DIR..."
    if ! qpkg_is_shared_misc_layout; then
        print_info "Custom install root ($NATIVE_TOOLS) — ports stay in this tree, not shared misc/"
    fi

    if [ ! -d "$INSTALL_DIR" ]; then
        print_error "Install directory not found: $INSTALL_DIR"
        rm -rf "$TEMP_DIR"
        exit 1
    fi

    if ! qpkg_extract_port_zip "$TEMP_DIR/$FILENAME" "$INSTALL_DIR" "$TEMP_DIR/extract"; then
        print_error "Failed to extract port archive"
        rm -rf "$TEMP_DIR"
        exit 1
    fi
    
    # Set executable permissions on binaries (only in NATIVE_TOOLS)
    if [ -d "$NATIVE_TOOLS/bin" ]; then
        chmod +x "$NATIVE_TOOLS/bin"/* 2>/dev/null
    fi
    
    # Set executable permissions on Python binaries (if this is Python)
    if [ "$PORT_NAME" = "python3" ] && [ -d "$NATIVE_TOOLS/lib/python3.11/tools/python3" ]; then
        chmod +x "$NATIVE_TOOLS/lib/python3.11/tools/python3"/* 2>/dev/null
    fi
    
    echo ""
    print_success "Port '$PORT_NAME' installed successfully!"
    log_installed_port "$PORT_NAME" "$VERSION" "$FILENAME"
    echo ""

    # Show installed binaries or apps (before cleanup)
    if [ "$PORT_NAME" = "android-apps" ] && [ -d "$INSTALL_DIR/android-apps" ]; then
        echo "Apps installed to $INSTALL_DIR/android-apps/:"
        ls -1 "$INSTALL_DIR/android-apps" | sed 's/^/  /'
    elif [ "$PORT_NAME" = "bcllm" ]; then
        install_bcllm_ai "$INSTALL_DIR/bcllm" || print_warning "Run: sh /accounts/1000/shared/misc/bcllm/setup-ai.sh"
    elif [ "$PORT_NAME" = "bdk-cli" ]; then
        install_bdk_cli "$INSTALL_DIR/bdk-cli" || print_warning "Run: sh /accounts/1000/shared/misc/bdk-cli/setup-bdk-cli.sh"
    elif [ "$PORT_NAME" = "openport" ]; then
        install_openport || print_warning "Check $(qpkg_misc_root)/bin/openport"
    elif [ "$PORT_NAME" = "telnet" ]; then
        install_misc_bin telnet && {
            echo "Telnet installed (netkit 0.17)"
            echo "  telnet 192.168.1.179"
            echo "  telnet host 8080"
            echo "Manual: $(qpkg_port_doc telnet)"
        }
    elif [ "$PORT_NAME" = "usbdbg" ]; then
        install_misc_bin usbdbg && {
            echo "usbdbg installed"
            echo "  usbdbg ports"
            echo "  usbdbg -p /dev/serusb1 probe"
            echo "Manual: $(qpkg_port_doc usbdbg)"
        }
    elif [ "$PORT_NAME" = "dropbear" ]; then
        mkdir -p "$(qpkg_misc_root)/etc/dropbear" 2>/dev/null || true
        install_misc_bin dbclient dropbear dropbearkey ssh && {
            echo "Dropbear SSH installed (2026.91)"
            echo "  ssh mp@192.168.1.179"
            echo "  dropbearkey -t ed25519 -f $(qpkg_misc_root)/etc/dropbear/id_ed25519"
            echo "Manual: $(qpkg_port_doc dropbear)"
        }
    elif [ "$PORT_NAME" = "bbm" ]; then
        install_misc_bin bbm berrymsg && {
            echo "BBM installed (Berry Bridge Messenger)"
            echo "  export BERRYRELAY_KEY=\"<relay key>\""
            echo "  bbm who"
            echo "  bbm send @all \"online\""
            echo "  bbm poll"
            echo "Manual: $(qpkg_port_doc bbm)"
        }
    elif [ "$PORT_NAME" = "ftp" ]; then
        install_misc_bin ftp bftpd pftp && {
            mkdir -p "$NATIVE_TOOLS/etc" "$NATIVE_TOOLS/ftp-root" "$NATIVE_TOOLS/var/log" 2>/dev/null || true
            if [ -f "$INSTALL_DIR/etc/bftpd.conf.example" ] && [ ! -f "$NATIVE_TOOLS/etc/bftpd.conf" ]; then
                cp "$INSTALL_DIR/etc/bftpd.conf.example" "$NATIVE_TOOLS/etc/bftpd.conf.example" 2>/dev/null || true
            fi
            echo "FTP installed (netkit client + bftpd server)"
            echo "  ftp hostname"
            echo "  bftpd -c $NATIVE_TOOLS/etc/bftpd.conf.example -D"
            echo "Manual: $(qpkg_port_doc ftp)"
        }
    elif [ "$PORT_NAME" = "ping" ]; then
        chmod +x "$NATIVE_TOOLS/bin/ping" 2>/dev/null || true
        echo "ping installed (ICMP echo — may require root on BB10)"
        echo "  ping -c 4 192.168.1.1"
    elif [ "$PORT_NAME" = "tcpdump" ]; then
        chmod +x "$NATIVE_TOOLS/bin/tcpdump" 2>/dev/null || true
        echo "tcpdump installed (v4.99.5 — may require root on BB10)"
        echo "  tcpdump -i bptp0 -c 10"
    elif [ "$PORT_NAME" = "qnx-doom" ]; then
        chmod +x "$NATIVE_TOOLS/bin/qnx-doom" 2>/dev/null || true
        chmod +x "$NATIVE_TOOLS/share/qnx-doom/bin/doomgeneric_qnx" 2>/dev/null || true
        chmod +x "$NATIVE_TOOLS/share/qnx-doom/scripts/doom_run.sh" 2>/dev/null || true
        echo "QNX Doom installed (Passport — NO AUDIO)"
        echo ""
        echo "  *** REQUIRES XSDL / X server on BB10 ***"
        echo "  1. Sideload APK: $NATIVE_TOOLS/share/qnx-doom/apks/"
        echo "  2. Start XSDL, note IP (e.g. 192.168.1.113:0)"
        echo "  3. export DISPLAY=192.168.1.113:0"
        echo "  4. Run on device (Term49), NOT over SSH:  qnx-doom"
        echo ""
        echo "Manual: $NATIVE_TOOLS/share/doc/qnx-doom/MANUAL.md"
    elif [ "$PORT_NAME" = "maps" ]; then
        chmod +x "$NATIVE_TOOLS/bin/maps" 2>/dev/null || true
        echo "Maps installed (OpenStreetMap + directions, port 8090)"
        echo "  python3 -m pip install requests   # if not installed"
        echo "  maps"
        echo "  Open http://localhost:8090"
    elif [ "$PORT_NAME" = "youtube" ]; then
        chmod +x "$NATIVE_TOOLS/bin/youtube" 2>/dev/null || true
        echo "YouTube v2 installed (search + embed playback, port 8070)"
        echo "  youtube"
        echo "  Open http://localhost:8070"
    elif [ "$PORT_NAME" = "telegram" ]; then
        chmod +x "$NATIVE_TOOLS/bin/telegram" 2>/dev/null || true
        echo "Telegram v2.1 installed (port 8010)"
        echo "  python3 -m pip install telethon requests   # if not installed"
        echo "  telegram"
        echo "  Open http://localhost:8010"
    elif [ "$PORT_NAME" = "rocketchat" ]; then
        chmod +x "$NATIVE_TOOLS/bin/rocketchat" 2>/dev/null || true
        echo "RocketChat v3 installed (port 8026)"
        echo "  rocketchat"
        echo "  Open http://localhost:8026"
    elif [ "$PORT_NAME" = "berry-browser" ]; then
        if [ -d "$NATIVE_TOOLS/share/berry-browser/bin" ]; then
            chmod +x "$NATIVE_TOOLS/share/berry-browser/bin/"* 2>/dev/null || true
            chmod +x "$NATIVE_TOOLS/bin/berry-browser" "$NATIVE_TOOLS/bin/browse" \
                "$NATIVE_TOOLS/bin/content_shell" "$NATIVE_TOOLS/bin/berry-browser-screen" 2>/dev/null || true
            chmod +x "$NATIVE_TOOLS/share/berry-browser/lib/"*.sh 2>/dev/null || true
            echo "BerryBrowser installed (build 27)"
            echo "  berry-browser URL      — CLI browser (Term49 / SSH)"
            echo "  berry-browser -l URL   — list links"
            echo "  berry-browser          — interactive mode"
            echo "  berry-browser-screen   — full-screen (native QNX only)"
            [ -f "$NATIVE_TOOLS/share/berry-browser/VERSION" ] && cat "$NATIVE_TOOLS/share/berry-browser/VERSION"
        fi
    elif [ -d "$NATIVE_TOOLS/bin" ]; then
        echo "Binaries installed:"
        ls -1 "$NATIVE_TOOLS/bin" | tail -10 | sed 's/^/  /'
    fi
    
    # Clean up
    rm -rf "$TEMP_DIR"
    
    echo ""
}

# Search full package catalog
cmd_search() {
    SEARCH_TERM="$1"

    if [ -z "$SEARCH_TERM" ]; then
        print_error "Usage: qpkg search <keyword>"
        exit 1
    fi

    print_header "Search Packages: $SEARCH_TERM"

    PACKAGES_CONTENT=$(fetch_packages_content)
    if [ $? -ne 0 ] || [ -z "$PACKAGES_CONTENT" ]; then
        print_error "Failed to fetch package catalog"
        exit 1
    fi

    {
        echo ""
        _found=0
        echo "$PACKAGES_CONTENT" | grep -v "^#" | grep -v "^$" | while IFS='|' read -r name cat ver size desc zip replaces; do
            _haystack="$name $cat $desc"
            if echo "$_haystack" | grep -i "$SEARCH_TERM" >/dev/null 2>&1; then
                display_package_row "$name" "$cat" "$ver" "$size" "$desc"
                _found=1
            fi
        done
        echo ""
        echo "Install with: qpkg install <name>"
        echo ""
    } | paginate
}

# List full package catalog
cmd_available() {
    FILTER_CAT=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--category)
                FILTER_CAT="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    print_header "Package Catalog"

    PACKAGES_CONTENT=$(fetch_packages_content)
    if [ $? -ne 0 ] || [ -z "$PACKAGES_CONTENT" ]; then
        print_error "Failed to fetch package catalog"
        exit 1
    fi

    {
        echo ""
        if [ -n "$FILTER_CAT" ]; then
            echo "Category: $FILTER_CAT"
            echo "==========================================================="
            echo ""
            echo "$PACKAGES_CONTENT" | grep -v "^#" | grep -v "^$" | while IFS='|' read -r name cat ver size desc zip replaces; do
                if [ "$cat" = "$FILTER_CAT" ]; then
                    display_package_row "$name" "$cat" "$ver" "$size" "$desc"
                fi
            done
        else
            _current=""
            echo "$PACKAGES_CONTENT" | grep -v "^#" | grep -v "^$" | sort -t'|' -k2,2 -k1,1 | while IFS='|' read -r name cat ver size desc zip replaces; do
                if [ "$cat" != "$_current" ]; then
                    _current="$cat"
                    echo ""
                    printf "${YELLOW}[%s]${NC}\n" "$cat"
                fi
                display_package_row "$name" "$cat" "$ver" "$size" "$desc"
            done
        fi
        echo ""
        echo "Featured only: qpkg ports"
        echo "Install with:  qpkg install <name>"
        echo ""
    } | paginate
}

# Show package details
cmd_show() {
    PKG="$1"

    if [ -z "$PKG" ]; then
        print_error "Usage: qpkg show <package-name>"
        exit 1
    fi

    PACKAGES_CONTENT=$(fetch_packages_content)
    if [ $? -ne 0 ] || [ -z "$PACKAGES_CONTENT" ]; then
        print_error "Failed to fetch package catalog"
        exit 1
    fi

    PORT_INFO=$(lookup_package_line "$PKG" "$PACKAGES_CONTENT")
    if [ -z "$PORT_INFO" ]; then
        print_error "Package '$PKG' not found"
        echo "Try: qpkg search $PKG"
        exit 1
    fi

    parse_package_fields "$PORT_INFO"

    print_header "Package: $PKG_NAME"
    echo "Category:    $PKG_CATEGORY"
    echo "Version:     $PKG_VERSION"
    echo "Size:        $PKG_SIZE"
    echo "Description: $PKG_DESC"
    echo "Zip:         $PKG_ZIP"
    echo "Replaces:    $PKG_REPLACES"
    echo ""

    if [ -f "${NATIVE_TOOLS}/.qpkg/installed" ]; then
        _inst=$(grep "^${PKG_NAME}|" "${NATIVE_TOOLS}/.qpkg/installed" 2>/dev/null | tail -1)
        if [ -n "$_inst" ]; then
            echo "Installed:   yes ($_inst)"
        else
            echo "Installed:   no"
        fi
    fi

    echo ""
    echo "Install: qpkg install $PKG_NAME"
    echo ""
}

# List installed packages
cmd_list() {
    print_header "Installed Packages"
    
    if [ -d "$NATIVE_TOOLS/packages" ]; then
        ls -1 "$NATIVE_TOOLS/packages/" | sed 's/.zip$//' | nl
    else
        print_error "Packages directory not found"
    fi
}

# Show package/binary info
cmd_info() {
    BINARY="$1"
    
    if [ -z "$BINARY" ]; then
        print_error "Usage: qpkg info <binary-name>"
        exit 1
    fi
    
    print_header "Binary Info: $BINARY"
    
    # Check if binary exists in bin/
    if [ -f "$NATIVE_TOOLS/bin/$BINARY" ]; then
        echo "Location: $NATIVE_TOOLS/bin/$BINARY"
        
        # Get info from catalog
        if [ -f "$NATIVE_TOOLS/CATALOG" ]; then
            INFO=$(grep "^$BINARY|" "$NATIVE_TOOLS/CATALOG" 2>/dev/null)
            if [ -n "$INFO" ]; then
                CATEGORY=$(echo "$INFO" | cut -d'|' -f2)
                DESCRIPTION=$(echo "$INFO" | cut -d'|' -f3)
                echo "Category: $CATEGORY"
                echo "Description: $DESCRIPTION"
            fi
        fi
        
        # Show file info
        echo ""
        ls -lh "$NATIVE_TOOLS/bin/$BINARY" | awk '{print "Size: " $5 "  Permissions: " $1}'
        
        # Try to get version
        echo ""
        if "$NATIVE_TOOLS/bin/$BINARY" --version 2>/dev/null | head -1; then
            :
        elif "$NATIVE_TOOLS/bin/$BINARY" -v 2>/dev/null | head -1; then
            :
        else
            echo "Version: (unknown)"
        fi
        
        # Check for man page
        echo ""
        if [ -f "$NATIVE_TOOLS/man/man1/$BINARY.1" ] || [ -f "$NATIVE_TOOLS/share/man/man1/$BINARY.1" ]; then
            echo "Manual: Available (run 'man $BINARY')"
        else
            echo "Manual: Not available"
        fi
        
        echo ""
    else
        # Check if it's a package
        if [ -f "$NATIVE_TOOLS/packages/${BINARY}.zip" ]; then
            echo "Package: ${BINARY}.zip"
            SIZE=$(ls -lh "$NATIVE_TOOLS/packages/${BINARY}.zip" | awk '{print $5}')
            echo "Size: $SIZE"
            print_success "Installed: Yes"
        else
            print_error "Binary or package '$BINARY' not found"
            echo ""
            echo "Try: qpkg catalog -s $BINARY"
            exit 1
        fi
    fi
}

# Pagination helper
paginate() {
    # Use less with smart options:
    # -F: quit if one screen
    # -X: don't clear screen on exit
    # -R: allow ANSI colors
    # -S: chop long lines (don't wrap)
    if command -v less >/dev/null 2>&1; then
        less -FXR
    else
        cat
    fi
}

# Show binary catalog
cmd_catalog() {
    CATALOG="$NATIVE_TOOLS/CATALOG"
    
    if [ ! -f "$CATALOG" ]; then
        print_error "Catalog file not found: $CATALOG"
        exit 1
    fi
    
    # Parse options
    MODE="list"
    ARG=""
    
    case "$1" in
        -c|--category)
            MODE="category"
            ARG="$2"
            if [ -z "$ARG" ]; then
                print_error "Usage: qpkg catalog -c <category>"
                exit 1
            fi
            ;;
        -s|--search)
            MODE="search"
            ARG="$2"
            if [ -z "$ARG" ]; then
                print_error "Usage: qpkg catalog -s <search-term>"
                exit 1
            fi
            ;;
        -h|--help)
            cat << 'HELPEOF'

Binary Catalog - Browse available binaries

Usage:
  qpkg catalog              List all binaries by category
  qpkg catalog -c CATEGORY  List binaries in specific category
  qpkg catalog -s TERM      Search for binaries

Categories:
  dev, shell, editor, util, net, sys, archive, media, data,
  x11, js, lang, security, time, comm, game, doc, build, calc,
  todo, emu

Examples:
  qpkg catalog           # Show all binaries
  qpkg catalog -c net    # Show networking tools
  qpkg catalog -s ssh    # Search for SSH-related tools

HELPEOF
            exit 0
            ;;
        "")
            MODE="list"
            ;;
        *)
            # Treat as search term
            MODE="search"
            ARG="$1"
            ;;
    esac
    
    # Generate output and paginate
    {
        case "$MODE" in
            list)
                echo ""
                printf "${BOLD}Available BerryCore Binaries${NC}\n"
                echo "==========================================================="
                echo ""
                
                current_cat=""
                grep -v "^#" "$CATALOG" | grep -v "^$" | sort -t'|' -k2,2 -k1,1 | while IFS='|' read -r name cat desc; do
                    if [ "$cat" != "$current_cat" ]; then
                        current_cat="$cat"
                        echo ""
                        printf "${YELLOW}[$cat]${NC}\n"
                    fi
                    printf "  ${GREEN}%-25s${NC} %s\n" "$name" "$desc"
                done
                echo ""
                ;;
                
            category)
                echo ""
                printf "${BOLD}BerryCore Binaries - Category: $ARG${NC}\n"
                echo "==========================================================="
                echo ""
                
                RESULTS=$(grep -v "^#" "$CATALOG" | grep -v "^$" | while IFS='|' read -r name cat desc; do
                    if [ "$cat" = "$ARG" ]; then
                        printf "  ${GREEN}%-25s${NC} %s\n" "$name" "$desc"
                    fi
                done)
                
                if [ -z "$RESULTS" ]; then
                    echo "  No binaries found in category: $ARG"
                else
                    echo "$RESULTS"
                fi
                echo ""
                ;;
                
            search)
                echo ""
                printf "${BOLD}Search results for: $ARG${NC}\n"
                echo "==========================================================="
                echo ""
                
                RESULTS=$(grep -v "^#" "$CATALOG" | grep -v "^$" | grep -i "$ARG" | while IFS='|' read -r name cat desc; do
                    printf "  %-25s [%s] %s\n" "$name" "$cat" "$desc"
                done)
                
                if [ -z "$RESULTS" ]; then
                    echo "  No results found for: $ARG"
                else
                    echo "$RESULTS"
                fi
                echo ""
                ;;
        esac
    } | paginate
}

# List all installed binaries
cmd_bins() {
    {
        echo ""
        printf "${BOLD}Installed Binaries${NC}\n"
        echo "==========================================================="
        echo ""
        
        if [ -d "$NATIVE_TOOLS/bin" ]; then
            CATALOG="$NATIVE_TOOLS/CATALOG"
            ls -1 "$NATIVE_TOOLS/bin" | while read -r bin; do
                # Try to find it in catalog
                if [ -f "$CATALOG" ]; then
                    desc=$(grep "^$bin|" "$CATALOG" 2>/dev/null | cut -d'|' -f3)
                    if [ -n "$desc" ]; then
                        printf "  ${GREEN}%-25s${NC} %s\n" "$bin" "$desc"
                    else
                        printf "  ${GREEN}%-25s${NC}\n" "$bin"
                    fi
                else
                    printf "  ${GREEN}%-25s${NC}\n" "$bin"
                fi
            done
        else
            print_error "bin directory not found"
        fi
        echo ""
    } | paginate
}

# Show help
cmd_help() {
    cat << EOF

${BOLD}qpkg${NC} - QNX Package Manager for BerryCore

${BOLD}USAGE:${NC}
  qpkg <command> [arguments]

${BOLD}COMMANDS:${NC}
  ${GREEN}update${NC}              Check for and install BerryCore updates
  ${GREEN}update --force${NC}      Reinstall latest release even if VERSION matches
  ${GREEN}ports${NC}               List featured ports (showcase)
  ${GREEN}available${NC} [options] List full package catalog
  ${GREEN}search${NC} <keyword>    Search full package catalog
  ${GREEN}show${NC} <package>      Show package details
  ${GREEN}install${NC} <package>   Install a package from catalog
  ${GREEN}catalog${NC} [options]   Browse installed binaries (replaces bclist)
  ${GREEN}bins${NC}                List all installed binaries (replaces bcbins)
  ${GREEN}info${NC} <binary>       Show binary information (replaces bcinfo)
  list                List installed packages
  help                Show this help message

${BOLD}CATALOG OPTIONS:${NC}
  qpkg catalog              List all binaries by category
  qpkg catalog -c net       Show networking tools only
  qpkg catalog -s ssh       Search for SSH-related tools

${BOLD}EXAMPLES:${NC}
  qpkg update                  # Update BerryCore to latest version
  qpkg catalog                 # Browse all available binaries
  qpkg catalog -s compress     # Search for compression tools
  qpkg bins                    # List all installed binaries
  qpkg info nano               # Show info about nano binary
  qpkg ports                   # Featured ports (showcase)
  qpkg search browser          # Search full catalog
  qpkg available -c net        # List net packages
  qpkg show telegram           # Package details
  qpkg install hydra           # Install from catalog

${BOLD}REPOSITORY:${NC}
  https://github.com/$GITHUB_REPO

${BOLD}VERSION:${NC}
  qpkg $VERSION

EOF
}

# Main command dispatcher
main() {
    init_native_tools

    COMMAND="$1"
    shift
    
    case "$COMMAND" in
        update)
            cmd_update "$@"
            ;;
        ports)
            cmd_ports "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        catalog)
            cmd_catalog "$@"
            ;;
        bins)
            cmd_bins "$@"
            ;;
        info)
            cmd_info "$@"
            ;;
        search)
            cmd_search "$@"
            ;;
        available)
            cmd_available "$@"
            ;;
        show)
            cmd_show "$@"
            ;;
        list)
            cmd_list "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        "")
            print_error "No command specified"
            echo "Run 'qpkg help' for usage information"
            exit 1
            ;;
        *)
            print_error "Unknown command: $COMMAND"
            echo "Run 'qpkg help' for available commands"
            exit 1
            ;;
    esac
}

# Run main
main "$@"

