#!/bin/sh
# mutt-setup — Interactive Mutt email configuration for BerryCore/BB10
# Run once to configure IMAP/SMTP and create ~/.muttrc
# Source: add to mutt-2.2.16.zip as bin/mutt-setup

DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
NATIVE_TOOLS="${NATIVE_TOOLS:-$ROOT}"

# Resolve cert path
CERT_FILE=""
if [ -f "$NATIVE_TOOLS/ssl/cert.pem" ]; then
  CERT_FILE="$NATIVE_TOOLS/ssl/cert.pem"
elif [ -f "$NATIVE_TOOLS/certs/cacert.pem" ]; then
  CERT_FILE="$NATIVE_TOOLS/certs/cacert.pem"
elif [ -f "$ROOT/ssl/cert.pem" ]; then
  CERT_FILE="$ROOT/ssl/cert.pem"
elif [ -f "$ROOT/certs/cacert.pem" ]; then
  CERT_FILE="$ROOT/certs/cacert.pem"
fi

# Ensure HOME
if [ -z "$HOME" ] || [ ! -d "$HOME" ]; then
  HOME="$ROOT"
  export HOME
fi

echo ""
echo "=============================================="
echo "  Mutt Email Setup — BerryCore"
echo "=============================================="
echo ""
echo "This will create ~/.muttrc with your IMAP/SMTP settings."
echo "Press Enter to use [default], or type a value."
echo ""

# Prompts with defaults
prompt() {
  _var="$1"
  _msg="$2"
  _default="$3"
  eval _val="\$$_var"
  if [ -n "$_val" ]; then
    _default="$_val"
  fi
  printf "%s [%s]: " "$_msg" "$_default"
  read _in
  eval "$_var=\${_in:-$_default}"
}

prompt EMAIL "Your email address" "you@example.com"
prompt REALNAME "Your display name" "BerryCore User"
prompt IMAP_HOST "IMAP server host" "imap.gmail.com"
prompt IMAP_PORT "IMAP port (993 for SSL)" "993"
prompt SMTP_HOST "SMTP server host" "smtp.gmail.com"
prompt SMTP_PORT "SMTP port (465 for SSL)" "465"

echo ""
echo "Password: leave blank to be prompted each time (recommended for security)"
printf "IMAP/SMTP password (optional): "
read IMAP_PASS

# Create directories
mkdir -p "$HOME/Mail" 2>/dev/null
touch "$HOME/Mail/inbox" 2>/dev/null
mkdir -p "$HOME/.cache/mutt/headers" 2>/dev/null

# Build config
MUTTRC="$HOME/.muttrc"
if [ -f "$MUTTRC" ]; then
  _bak="$MUTTRC.bak.$(date +%Y%m%d%H%M%S)"
  cp "$MUTTRC" "$_bak"
  echo "Backed up existing config to $_bak"
fi

{
  echo "# Mutt config — generated by mutt-setup"
  echo "# Edit ~/.muttrc to customize"
  echo ""
  echo "# Identity"
  echo "set from = \"$EMAIL\""
  echo "set realname = \"$REALNAME\""
  echo "set imap_user = \"$EMAIL\""
  echo ""
  echo "# IMAP"
  echo "set folder = \"imaps://${IMAP_HOST}:${IMAP_PORT}/\""
  echo "set spoolfile = \"+INBOX\""
  echo "set postponed = \"+Drafts\""
  echo "set record = \"+Sent\""
  echo "set trash = \"+Trash\""
  echo "mailboxes \"+INBOX\" \"+Sent\" \"+Drafts\" \"+Trash\""
  echo ""
  echo "# SMTP"
  echo "set smtp_url = \"smtps://${EMAIL}@${SMTP_HOST}:${SMTP_PORT}\""
  echo ""
  echo "# Header cache"
  echo "set header_cache = \"~/.cache/mutt/headers\""
  echo "set imap_check_subscribed = yes"
  echo "set imap_keepalive = 300"
  echo ""
  if [ -n "$CERT_FILE" ]; then
    echo "# TLS certificates"
    echo "set certificate_file = \"$CERT_FILE\""
    echo ""
  else
    echo "# TLS: set certificate_file if needed"
  fi
  if [ -n "$IMAP_PASS" ]; then
    echo "# Password (consider removing for security)"
    echo "set imap_pass = \"$IMAP_PASS\""
    echo "set smtp_authenticators = \"login\""
  fi
} > "$MUTTRC"

echo ""
echo "=============================================="
echo "  Setup complete!"
echo "=============================================="
echo ""
echo "Config written to: $MUTTRC"
echo ""
echo "Run mutt to start:"
echo "  mutt"
echo ""
echo "For Gmail/Google: enable 'Less secure app access' or use an App Password."
echo ""
