#!/bin/sh
# BerryCore: dcron crontab wrapper (dcron 4.5)
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
NATIVE_TOOLS="$(cd "$BIN_DIR/.." && pwd)"
export CRON_USER="${CRON_USER:-berrycore}"
mkdir -p "$NATIVE_TOOLS/cron/crontabs" "$NATIVE_TOOLS/cron/cronstamps" "$NATIVE_TOOLS/cron/cron.d" 2>/dev/null
exec "$BIN_DIR/crontab.bin" -c "$NATIVE_TOOLS/cron/crontabs" "$@"
