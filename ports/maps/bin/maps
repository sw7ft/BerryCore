#!/bin/sh
# maps - OpenStreetMap navigation for BB10
# Search locations, view maps, get driving directions. Requires python3 + requests.
# Install: qpkg install maps

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
NATIVE_TOOLS="$(cd "$BIN_DIR/.." 2>/dev/null && pwd)"
[ -z "$NATIVE_TOOLS" ] && NATIVE_TOOLS="/accounts/1000/shared/misc/berrycore"
SHARE="$NATIVE_TOOLS/share/maps"
PORT=8090

FOREGROUND=0
for arg in "$@"; do
    case "$arg" in
        help|-h|--help)
            if [ -f "$SHARE/HELP.txt" ]; then
                cat "$SHARE/HELP.txt"
            else
                echo "maps - OpenStreetMap navigation for BB10"
                echo ""
                echo "Usage: maps          # Start in background (default)"
                echo "       maps -f       # Run in foreground"
                echo ""
                echo "Open http://localhost:$PORT in browser."
                echo "Requires: python3, requests (python3 -m pip install requests)"
            fi
            exit 0
            ;;
        -f|--foreground) FOREGROUND=1 ;;
    esac
done

PYTHON=""
for p in python3 python3.11 python3.2; do
    if command -v $p >/dev/null 2>&1; then
        PYTHON="$p"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "maps: python3 not found. Run: qpkg install python3"
    exit 1
fi

if ! "$PYTHON" -c "import requests" 2>/dev/null; then
    echo "maps: Python module 'requests' not found."
    echo "Run: python3 -m ensurepip && python3 -m pip install requests"
    exit 1
fi

if [ ! -f "$SHARE/app.py" ]; then
    echo "maps: app.py not found in $SHARE"
    echo "Run: qpkg install maps"
    exit 1
fi

if [ "$FOREGROUND" = 1 ]; then
    exec "$PYTHON" "$SHARE/app.py"
fi

LOG="$SHARE/maps.log"
mkdir -p "$SHARE" 2>/dev/null
echo "maps: starting in background (log: $LOG)"
echo "Open http://localhost:$PORT in browser"
nohup "$PYTHON" "$SHARE/app.py" >> "$LOG" 2>&1 &
