#!/bin/sh
# STT lab — PocketSphinx vs Vosk compare UI on port 8093
# Usage: sttlab [start|stop|status|term|demo|vosk|rec]
#        sttlabs  →  Term49 text UI (same as sttlab term)

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
NATIVE="$(cd "$BIN_DIR/.." && pwd)"
WEB="$NATIVE/share/sttlab"
PORT="${BERRYCORE_STTLAB_PORT:-8093}"
PIDFILE="$NATIVE/.tmp/sttlab.pid"
LOG="$NATIVE/.tmp/sttlab.log"
PY="$NATIVE/bin/python3"
BC_PY="$NATIVE/lib/python3_ntoarmv7-qnx-static/tools/python3/python3"
if [ -x "$PY" ]; then
    :
elif [ -x "$BC_PY" ]; then
    PY="$BC_PY"
    export PYTHONHOME="$NATIVE/lib/python3_ntoarmv7-qnx-static"
    export PYTHONPATH=
else
    PY="python3"
fi

# Engine tree: qpkg vosk installs lib/ + share/stt/model into NATIVE_TOOLS.
# Legacy device tree stays at /misc/stt.
if [ -n "$STT_ROOT" ]; then
    :
elif [ -f "$NATIVE/lib/libvosk.so" ] || [ -d "$NATIVE/share/stt/model/vosk-en" ]; then
    STT_ROOT="$NATIVE"
elif [ -d /accounts/1000/shared/misc/stt ]; then
    STT_ROOT="/accounts/1000/shared/misc/stt"
else
    STT_ROOT="$NATIVE"
fi
export STT_ROOT

# Device lab also lives under /misc/stt/web (older layout).
if [ ! -f "$WEB/serve.py" ] && [ -f "$STT_ROOT/web/serve.py" ]; then
    WEB="$STT_ROOT/web"
    PIDFILE="$STT_ROOT/tmp/sttlab.pid"
    LOG="$STT_ROOT/tmp/sttlab.log"
fi

cmd="${1:-}"
if [ -z "$cmd" ]; then
    case "$(basename "$0")" in
        sttlabs|stt-labs) cmd="term" ;;
        *) cmd="start" ;;
    esac
fi
mkdir -p "$NATIVE/.tmp" "$STT_ROOT/tmp" 2>/dev/null || mkdir -p "$NATIVE/.tmp"

is_running() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    return 1
}

do_start() {
    if [ ! -f "$WEB/serve.py" ]; then
        echo "sttlab: missing $WEB/serve.py"
        return 1
    fi
    if is_running; then
        echo "STT lab already running — http://127.0.0.1:$PORT/"
        return 0
    fi
    nohup "$PY" "$WEB/serve.py" "$PORT" >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if is_running; then
        echo "STT lab  http://127.0.0.1:$PORT/"
        echo "Term49:  sttlabs     (text UI)   or   berry-browser http://127.0.0.1:$PORT/term"
        echo "Open in berry-browser.  sttlab stop  to quit."
        if [ ! -f "$STT_ROOT/lib/libvosk.so" ] && [ ! -f "$NATIVE/lib/libvosk.so" ]; then
            echo "Vosk engine not installed yet — qpkg install vosk"
        fi
        return 0
    fi
    echo "sttlab: failed — see $LOG"
    return 1
}

do_term() {
    if ! do_start; then
        return 1
    fi
    TERM49="$WEB/term49.py"
    if [ ! -f "$TERM49" ]; then
        echo "sttlabs: missing $TERM49"
        return 1
    fi
    if [ "$1" = "term" ] || [ "$1" = "tui" ] || [ "$1" = "menu" ] || [ "$1" = "sttlabs" ]; then
        shift
    fi
    exec "$PY" "$TERM49" "$@"
}

case "$cmd" in
    start)
        do_start
        ;;
    stop)
        if is_running; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
            rm -f "$PIDFILE"
            echo "STT lab stopped"
        else
            echo "sttlab: not running"
        fi
        ;;
    status)
        if is_running; then
            echo "running  pid $(cat "$PIDFILE")  http://127.0.0.1:$PORT/"
        else
            echo "stopped"
            exit 1
        fi
        ;;
    term|tui|menu|sttlabs)
        do_term "$@"
        ;;
    demo|vosk|rec|record|file|decode)
        if ! do_start; then
            exit 1
        fi
        exec "$PY" "$WEB/term49.py" "$@"
        ;;
    -h|--help|help)
        echo "Usage: sttlab [start|stop|status|term|demo|vosk|rec]"
        echo "  start   compare lab on port $PORT"
        echo "  stop    stop the lab"
        echo "  term    Term49 text UI (also: sttlabs)"
        echo "  demo    run official goforward clip"
        echo "Engine:  qpkg install vosk"
        ;;
    *)
        echo "Usage: sttlab [start|stop|status|term|demo|vosk|rec]"
        exit 1
        ;;
esac
