#!/bin/sh
# QNX Doom launcher — XSDL / X server on BB10 (see MANUAL.md)
NT="${NATIVE_TOOLS:-/accounts/1000/shared/misc/berrycore}"
DOOM="$NT/share/qnx-doom"
RUN="$DOOM/scripts/doom_run.sh"

if [ ! -x "$DOOM/bin/doomgeneric_qnx" ]; then
    echo "qnx-doom: game files not found. Run: qpkg install qnx-doom"
    exit 1
fi

# Prompt for DISPLAY if unset; default localhost (XSDL on same device)
if [ -z "$DISPLAY" ]; then
    echo ""
    echo "QNX Doom uses an X11 display — start XSDL first (APK: share/qnx-doom/apks/)."
    echo "Press Enter for localhost, or type the address XSDL shows (e.g. 192.168.1.113:0)."
    printf "Display [127.0.0.1:0]: "
    read _disp
    if [ -z "$_disp" ]; then
        DISPLAY="127.0.0.1:0"
    else
        DISPLAY="$_disp"
    fi
    case "$DISPLAY" in
        *:*) ;;
        *) DISPLAY="${DISPLAY}:0" ;;
    esac
    export DISPLAY
    echo "Using DISPLAY=$DISPLAY"
    echo ""
fi

export LD_LIBRARY_PATH="$DOOM/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec sh "$RUN" "$@"
