#!/bin/sh
# Stocks — ticker, lists, upticks, PPS alerts on port 8096

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
NATIVE_TOOLS="$(cd "$BIN_DIR/.." && pwd)"
WEB="$NATIVE_TOOLS/share/stocks"
PORT="${BERRYCORE_STOCKS_PORT:-8096}"
PIDFILE="$NATIVE_TOOLS/.tmp/stocks.pid"
LOG="$NATIVE_TOOLS/.tmp/stocks.log"
export BERRYCORE_STOCKS_STATE="${BERRYCORE_STOCKS_STATE:-$NATIVE_TOOLS/.tmp/stocks-state.json}"
PY="$NATIVE_TOOLS/bin/python3"
BC_PY="$NATIVE_TOOLS/lib/python3_ntoarmv7-qnx-static/tools/python3/python3"
if [ -x "$PY" ]; then
    :
elif [ -x "$BC_PY" ]; then
    PY="$BC_PY"
    export PYTHONHOME="$NATIVE_TOOLS/lib/python3_ntoarmv7-qnx-static"
    export PYTHONPATH=
else
    PY="python3"
fi

cmd="${1:-start}"

is_running() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    return 1
}

do_start() {
    if [ ! -f "$WEB/serve.py" ]; then
        echo "stocks: missing $WEB/serve.py"
        exit 1
    fi
    if is_running; then
        echo "Stocks already running — http://127.0.0.1:$PORT/"
        exit 0
    fi
    mkdir -p "$NATIVE_TOOLS/.tmp"
    nohup "$PY" "$WEB/serve.py" "$PORT" >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if is_running; then
        echo "Stocks  http://127.0.0.1:$PORT/"
        echo "Open in berry-browser.  stocks stop  to quit."
    else
        echo "stocks: failed to start — see $LOG"
        exit 1
    fi
}

do_stop() {
    if is_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        echo "Stocks stopped"
    else
        echo "stocks: not running"
    fi
}

do_status() {
    if is_running; then
        echo "running  pid $(cat "$PIDFILE")  http://127.0.0.1:$PORT/"
    else
        echo "stopped"
        exit 1
    fi
}

case "$cmd" in
    start)  do_start ;;
    stop)   do_stop ;;
    status) do_status ;;
    -h|--help|help)
        echo "Usage: stocks [start|stop|status]"
        echo "  Stock ticker / research on port $PORT"
        echo "Also: ticker"
        ;;
    *)
        echo "Unknown command: $cmd"
        echo "Usage: stocks [start|stop|status]"
        exit 1
        ;;
esac
