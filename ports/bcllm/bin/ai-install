#!/bin/sh
# Add BerryCore AI to PATH — run if ai is missing after qpkg install bcllm
AI_HOME="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
AI_BIN="${AI_HOME}/bin"
NT="${NATIVE_TOOLS:-/accounts/1000/shared/misc/berrycore}"
MARK="# BerryCore AI"
PROFILE="${HOME}/.profile"
[ -f "$HOME/.bash_profile" ] && PROFILE="$HOME/.bash_profile"

if [ ! -x "$AI_BIN/bcllm-ai" ]; then
	printf 'ERROR: ai not found at %s/bcllm-ai\n' "$AI_BIN"
	exit 1
fi

# Ensure bin/ai is the wrapper script
if [ -L "$AI_BIN/ai" ] || [ ! -f "$AI_BIN/ai" ]; then
	if [ -f "$AI_BIN/berrycore-ai" ]; then
		cp "$AI_BIN/berrycore-ai" "$AI_BIN/ai"
	else
		cat > "$AI_BIN/ai" << 'EOF'
#!/bin/sh
exec /accounts/1000/shared/misc/bcllm/bin/bcllm-ai "$@"
EOF
	fi
	chmod +x "$AI_BIN/ai"
fi

mkdir -p "$NT/bin"
rm -f "$NT/bin/ai" "$NT/bin/AI"
cp "$AI_BIN/ai" "$NT/bin/ai"
chmod +x "$NT/bin/ai"
ln -sf ai "$NT/bin/AI" 2>/dev/null

if grep -q "$MARK" "$PROFILE" 2>/dev/null; then
	printf 'BerryCore AI already in %s\n' "$PROFILE"
else
	printf '\n%s\n' "$MARK" >> "$PROFILE"
	printf 'export PATH=%s:$PATH\n' "$AI_BIN" >> "$PROFILE"
	printf 'Added to %s\n' "$PROFILE"
fi

mkdir -p "$AI_HOME/models" "$AI_HOME/var" 2>/dev/null

printf '\nTry:\n\n  ai "hello"\n\n'
