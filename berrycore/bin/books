#!/bin/sh
# BerryCore Library — EPUB library + reader on port 8094
# Usage: library [start|stop|status]   (also: books)

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
NATIVE_TOOLS="$(cd "$BIN_DIR/.." && pwd)"
WEB="$NATIVE_TOOLS/share/books"
PORT="${BERRYCORE_BOOKS_PORT:-8094}"
PIDFILE="$NATIVE_TOOLS/.tmp/books.pid"
LOG="$NATIVE_TOOLS/.tmp/books.log"
PY="$NATIVE_TOOLS/bin/python3"
BC_PY="$NATIVE_TOOLS/lib/python3_ntoarmv7-qnx-static/tools/python3/python3"
if [ -x "$PY" ]; then
    :
elif [ -x "$BC_PY" ]; then
    PY="$BC_PY"
    export PYTHONHOME="$NATIVE_TOOLS/lib/python3_ntoarmv7-qnx-static"
    export PYTHONPATH=
else
    PY="python3"
fi

export BERRYCORE_BOOKS="${BERRYCORE_BOOKS:-/accounts/1000/shared/books}"
export BERRYCORE_BOOKS_PROGRESS="${BERRYCORE_BOOKS_PROGRESS:-$NATIVE_TOOLS/.tmp/books-progress.json}"
export BERRYCORE_BOOKS_BOOKMARKS="${BERRYCORE_BOOKS_BOOKMARKS:-$NATIVE_TOOLS/.tmp/books-bookmarks.json}"
export BERRYCORE_BOOKS_CATEGORIES="${BERRYCORE_BOOKS_CATEGORIES:-$NATIVE_TOOLS/.tmp/books-categories.json}"

cmd="${1:-start}"

is_running() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    return 1
}

do_start() {
    if [ ! -f "$WEB/index.html" ]; then
        echo "books: missing $WEB/index.html"
        exit 1
    fi
    if is_running; then
        echo "Library already running — http://127.0.0.1:$PORT/"
        exit 0
    fi
    mkdir -p "$NATIVE_TOOLS/.tmp"
    nohup "$PY" "$WEB/serve.py" "$PORT" >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    if is_running; then
        echo "Library  http://127.0.0.1:$PORT/"
        echo "Open in berry-browser.  library stop  to quit."
    else
        echo "books: failed to start — see $LOG"
        exit 1
    fi
}

do_stop() {
    if is_running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
        echo "Library stopped"
    else
        echo "library: not running"
    fi
}

do_status() {
    if is_running; then
        echo "running  pid $(cat "$PIDFILE")  http://127.0.0.1:$PORT/"
    else
        echo "stopped"
        exit 1
    fi
}

case "$cmd" in
    start)  do_start ;;
    stop)   do_stop ;;
    status) do_status ;;
    -h|--help|help)
        echo "Usage: library [start|stop|status]"
        echo "  start   EPUB library from /accounts/1000/shared/books on port $PORT"
        echo "  stop    stop the library server"
        echo "  status  show if running"
        echo "Also installed as: books"
        ;;
    *)
        echo "Unknown command: $cmd"
        echo "Usage: library [start|stop|status]"
        exit 1
        ;;
esac
